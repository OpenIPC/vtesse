<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- servers (#26, #27) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Button
                android:id="@+id/profile_1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:singleLine="true" />
            <Button
                android:id="@+id/profile_2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:singleLine="true" />
            <Button
                android:id="@+id/profile_3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:singleLine="true" />
        </LinearLayout>

        <TextView
            android:id="@+id/state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="18sp"
            android:textStyle="bold"
            android:paddingTop="4dp"
            android:paddingBottom="8dp" />

        <Button
            android:id="@+id/toggle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/start" />

        <!-- server -->
        <TextView style="@style/Section" android:text="@string/section_server" />

        <TextView style="@style/Label" android:text="@string/server_name" />
        <EditText
            android:id="@+id/profile_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textCapSentences"
            android:hint="@string/server_name_hint" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="3"
                android:orientation="vertical">
                <TextView style="@style/Label" android:text="@string/server" />
                <EditText
                    android:id="@+id/host"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textUri"
                    android:hint="vtun.example.org" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView style="@style/Label" android:text="@string/port" />
                <EditText
                    android:id="@+id/port"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number" />
            </LinearLayout>
        </LinearLayout>

        <TextView style="@style/Label" android:text="@string/device_id" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <EditText
                android:id="@+id/device_id"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="monospace"
                android:inputType="textCapCharacters|textNoSuggestions"
                android:maxLength="12" />
            <Button
                android:id="@+id/generate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/generate" />
        </LinearLayout>

        <TextView style="@style/Label" android:text="@string/password" />
        <EditText
            android:id="@+id/password"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textPassword" />

        <!-- cameras (#27) -->
        <TextView style="@style/Section" android:text="@string/section_cameras" />
        <TextView style="@style/Label" android:text="@string/services" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <CheckBox android:id="@+id/svc_rtsp" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:singleLine="true" />
            <CheckBox android:id="@+id/svc_http" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:singleLine="true" />
            <CheckBox android:id="@+id/svc_ssh" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:singleLine="true" />
            <CheckBox android:id="@+id/svc_socks" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:singleLine="true" />
        </LinearLayout>
        <!-- RTP over UDP pushed by cameras (#28) -->
        <CheckBox
            android:id="@+id/svc_udp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- 8 rows filled by MainActivity -->
        <LinearLayout
            android:id="@+id/cameras"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView style="@style/Section" android:text="@string/section_extra" />
        <TextView style="@style/Label" android:text="@string/forwards" />
        <EditText
            android:id="@+id/forwards"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:gravity="top"
            android:hint="@string/forwards_hint"
            android:inputType="textMultiLine|textNoSuggestions"
            android:minLines="1" />

        <TextView
            android:id="@+id/details"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="12dp"
            android:fontFamily="monospace"
            android:textIsSelectable="true"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
