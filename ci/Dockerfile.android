# Android build environment for android/ (APK): JDK 17, Android SDK, NDK, CMake, Gradle.
# Used locally (android/build.sh) and in CI.
FROM eclipse-temurin:17-jdk-jammy

ARG CMDLINE_TOOLS=11076708
ARG GRADLE_VERSION=8.11.1
ARG ANDROID_PLATFORM=35
ARG BUILD_TOOLS=35.0.0
ARG NDK_VERSION=27.2.12479018
ARG CMAKE_VERSION=3.22.1

ENV ANDROID_HOME=/opt/android-sdk \
    GRADLE_HOME=/opt/gradle \
    GRADLE_USER_HOME=/cache/gradle
ENV PATH=$PATH:$ANDROID_HOME/cmdline-tools/latest/bin:$ANDROID_HOME/platform-tools:$GRADLE_HOME/bin

RUN apt-get update \
 && apt-get install -y --no-install-recommends unzip curl ca-certificates \
 && rm -rf /var/lib/apt/lists/*

RUN mkdir -p $ANDROID_HOME/cmdline-tools \
 && curl -fsSL --retry 3 -o /tmp/tools.zip \
      https://dl.google.com/android/repository/commandlinetools-linux-${CMDLINE_TOOLS}_latest.zip \
 && unzip -q /tmp/tools.zip -d $ANDROID_HOME/cmdline-tools \
 && mv $ANDROID_HOME/cmdline-tools/cmdline-tools $ANDROID_HOME/cmdline-tools/latest \
 && rm /tmp/tools.zip \
 && yes | sdkmanager --licenses >/dev/null \
 && sdkmanager --install "platform-tools" "platforms;android-${ANDROID_PLATFORM}" \
      "build-tools;${BUILD_TOOLS}" "ndk;${NDK_VERSION}" "cmake;${CMAKE_VERSION}" >/dev/null \
 && chmod -R a+rwX $ANDROID_HOME

RUN curl -fsSL --retry 3 -o /tmp/gradle.zip \
      https://services.gradle.org/distributions/gradle-${GRADLE_VERSION}-bin.zip \
 && unzip -q /tmp/gradle.zip -d /opt \
 && mv /opt/gradle-${GRADLE_VERSION} $GRADLE_HOME \
 && rm /tmp/gradle.zip \
 && mkdir -p /cache/gradle && chmod -R a+rwX /cache

WORKDIR /src
