# /etc/systemd/system/vtesse.service — VTesse service for a Linux PC (systemd).
#
#   systemctl enable --now vtesse
#
# Installed by "vtesse --install". Runs the userspace stack; the server reaches
# the services of this machine through the accept= lines of /etc/vtesse.conf.

[Unit]
Description=VTesse VTun client
Wants=network-online.target
After=network-online.target

[Service]
ExecStart=/usr/local/bin/vtesse --config /etc/vtesse.conf
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
