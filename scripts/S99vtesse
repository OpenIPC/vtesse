#!/bin/sh
# /etc/init.d/S99vtesse — start VTesse at boot (OpenIPC and other BusyBox systems).
#
#   /etc/init.d/S99vtesse start|stop|restart|status
#
# Runs the TAP backend with the hook scripts from /usr/share/vtesse.
# Settings can be overridden in /etc/default/vtesse.

DAEMON=/usr/bin/vtesse
CONFIG=/etc/vtesse.conf
PIDFILE=/var/run/vtesse.pid
ARGS="--tap --ifname vtesse0 --hook /usr/share/vtesse/vtesse-hook.sh"
[ -f /etc/default/vtesse ] && . /etc/default/vtesse

start() {
    if [ ! -f "$CONFIG" ]; then
        echo "vtesse: $CONFIG not found, not starting"
        return 1
    fi
    printf "Starting vtesse: "
    start-stop-daemon -S -q -b -m -p "$PIDFILE" -x "$DAEMON" -- --config "$CONFIG" $ARGS \
        && echo "OK" || echo "FAIL"
}

stop() {
    printf "Stopping vtesse: "
    start-stop-daemon -K -q -p "$PIDFILE" && echo "OK" || echo "not running"
    rm -f "$PIDFILE"
}

case "$1" in
    start)   start ;;
    stop)    stop ;;
    restart) stop; sleep 1; start ;;
    status)
        if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
            echo "vtesse is running (pid $(cat "$PIDFILE"))"
        else
            echo "vtesse is not running"
            exit 1
        fi
        ;;
    *) echo "Usage: $0 {start|stop|restart|status}"; exit 1 ;;
esac
