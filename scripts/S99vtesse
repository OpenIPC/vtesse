#!/bin/sh
# /etc/init.d/S99vtesse — start VTesse at boot (OpenIPC and other BusyBox systems).
#
#   /etc/init.d/S99vtesse start|stop|restart|status
#
# Installed by "vtesse --install". Runs the TAP backend with the built-in hook
# scripts, or with the copies in /usr/libexec/vtesse when they exist
# ("vtesse --install --scripts"). Settings can be overridden in /etc/default/vtesse.
# The U-Boot variables vtesse (the server) and vtesse_* override the config.

DAEMON=/usr/bin/vtesse
CONFIG=/etc/vtesse.conf
PIDFILE=/var/run/vtesse.pid
ARGS="--tap --ifname vtesse0"
[ -f /etc/default/vtesse ] && . /etc/default/vtesse
# stop/status match the process by name, not by the executable: "vtesse --install"
# replaces the binary under a running daemon
NAME=$(basename "$DAEMON")

start() {
    # helpdesk access (#64): "fw_setenv vtesse <server>" is enough, without a config
    if [ ! -f "$CONFIG" ] && [ -z "$(fw_printenv -n vtesse 2>/dev/null)" ]; then
        echo "vtesse: neither $CONFIG nor vtesse in the U-Boot environment, not starting"
        return 1
    fi
    [ -e /dev/net/tun ] || modprobe tun 2>/dev/null
    printf "Starting vtesse: "
    start-stop-daemon -S -q -b -m -p "$PIDFILE" -x "$DAEMON" -- --config "$CONFIG" $ARGS \
        && echo "OK" || echo "FAIL"
}

stop() {
    printf "Stopping vtesse: "
    # -n: a stale PID file must not make us signal another process that reused the PID
    start-stop-daemon -K -q -p "$PIDFILE" -n "$NAME" && echo "OK" || echo "not running"
    rm -f "$PIDFILE"
}

case "$1" in
    start)   start ;;
    stop)    stop ;;
    restart) stop; sleep 1; start ;;
    status)
        if [ -f "$PIDFILE" ] && start-stop-daemon -K -t -q -p "$PIDFILE" -n "$NAME"; then
            echo "vtesse is running (pid $(cat "$PIDFILE"))"
        else
            echo "vtesse is not running"
            exit 1
        fi
        ;;
    *) echo "Usage: $0 {start|stop|restart|status}"; exit 1 ;;
esac
