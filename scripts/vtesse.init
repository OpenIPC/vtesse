#!/bin/sh /etc/rc.common
# /etc/init.d/vtesse — VTesse service for OpenWrt (procd).
#
#   /etc/init.d/vtesse enable && /etc/init.d/vtesse start
#
# Installed by "vtesse --install". Runs the userspace stack and restarts it if it
# exits; the server reaches the router's services through accept= (#67).

START=99
USE_PROCD=1

start_service() {
    # helpdesk access (#64): "fw_setenv vtesse <server>" is enough, without a config
    [ -f /etc/vtesse.conf ] || [ -n "$(fw_printenv -n vtesse 2>/dev/null)" ] ||
        { echo "vtesse: neither /etc/vtesse.conf nor vtesse in the U-Boot environment"; return 1; }
    procd_open_instance
    procd_set_param command /usr/bin/vtesse --config /etc/vtesse.conf
    procd_set_param respawn
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
