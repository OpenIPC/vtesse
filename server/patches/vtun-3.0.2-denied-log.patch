+/* Client-supplied session name, made safe for syslog: printable ASCII only. */
+static void log_name(char *dst, int len, const char *src)
+{
+	int i;
+
+	for(i=0; i < len-1 && src[i]; i++)
+	   dst[i] = ((unsigned char)src[i] > 0x20 && (unsigned char)src[i] < 0x7f) ? src[i] : '?';
+	dst[i] = '\0';
+}
+
+/* Authentication (Server side).
+ * On failure returns NULL and leaves the reason, with the session name the
+ * client sent, in why[] for the "Denied connection" log line. */
+struct vtun_host * auth_server(int fd, char *why, int why_len)
 {
         char chal_req[VTUN_CHAL_SIZE], chal_res[VTUN_CHAL_SIZE];	
